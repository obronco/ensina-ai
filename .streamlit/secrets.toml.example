# Streamlit Cloud Secrets Configuration
# Copy this to Streamlit Cloud's Secrets management
# (App Settings → Secrets)

# Anthropic API Configuration
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"

# Model Configuration (Optional - defaults provided)
# SLOW_MODEL: For complex tasks (tutoring, analysis) - high quality, higher cost
SLOW_MODEL = "claude-3-5-sonnet-20241022"

# FAST_MODEL: For simple tasks (guardrails, classification) - fast, lower cost
FAST_MODEL = "claude-3-5-haiku-20241022"

# Database Configuration (Streamlit Cloud uses ephemeral storage)
# The database will be created in the container's filesystem
DATABASE_PATH = "data/ensina.db"

# Application Configuration
APP_NAME = "Ensina AI"
